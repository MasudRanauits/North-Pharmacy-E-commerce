{
  "name": "north-pharmacy-e-commerce",
  "version": "1.0.0",
  "description": "Playwright test automation suite for the North Pharmacy e-commerce site (NP-QA-TC-001 v1.3).",
  "main": "index.js",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:smoke": "playwright test tests/smoke --project=chromium",
    "test:regression": "playwright test tests/regression --project=chromium",
    "test:e2e": "playwright test tests/E2E --project=chromium",
    "test:api": "playwright test tests/api --project=chromium",
    "test:p1": "playwright test --grep @p1 --project=chromium",
    "test:critical": "playwright test --grep @critical --project=chromium",
    "test:customer": "playwright test tests/regression/customer --project=chromium",
    "test:admin": "playwright test tests/regression/admin --project=chromium",
    "test:crosscutting": "playwright test tests/regression/cross-cutting --project=chromium",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:all-browsers": "playwright test",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "codegen": "playwright codegen $BASE_URL --ignore-https-errors"
  },
  "keywords": ["playwright", "qa", "north-pharmacy"],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5"
  }
}
