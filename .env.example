# North Pharmacy test suite — environment configuration.
#
# Copy to `.env` and fill in for your own installation, or export these before
# running. The repository deliberately ships no real host and no real
# credentials, so the suite cannot be pointed at anyone else's environment by
# accident.
#
#   cp .env.example .env
#
# playwright.config.ts loads `.env` on start-up when the file is present, so
# `cp .env.example .env` and filling it in is enough. Exporting the variables
# yourself works too and takes precedence on some shells.
#
# QUOTE any value containing '#'. A bare # starts a comment, so
#   TEST_PASSWORD=abc#123   is read as   abc
#   TEST_PASSWORD='abc#123' is read as   abc#123
# Passwords with # are common; this one costs an afternoon if you miss it.

# --- environment ------------------------------------------------------------
# The storefront root. The admin lives under /admin on the same host.
BASE_URL=https://your-environment.example.com

# --- accounts ---------------------------------------------------------------
# The shared QA customer.
TEST_USER=01000000001
TEST_PASSWORD=
TEST_USER_NAME=QA Customer

# The store administrator.
ADMIN_USER=01000000002
ADMIN_PASSWORD=
ADMIN_USER_NAME=Store Admin

# A second, unrelated customer. Used only by the negative cases that assert one
# account cannot see another's details. Leave unset to keep those cases running
# against a placeholder; set it to a real account to make them meaningful.
OTHER_CUSTOMER_MOBILE=
OTHER_CUSTOMER_NAME=

# --- seeded orders ----------------------------------------------------------
# Order references that already exist in your environment, per NP-QA-TC-001
# §2.6. Cases that need them skip the reference when it is not set.
ORDER_PENDING=
ORDER_PACKED=
ORDER_CANCELLED=

# --- run options ------------------------------------------------------------
# Set to 1 to exclude the cases that write real data (settings, orders,
# prescription decisions). Leave unset when running against a UAT environment
# whose data may change.
SKIP_DESTRUCTIVE=
